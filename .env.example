# =============================================================================
# ASK-DSA Configuration
# =============================================================================

# Groq API Key (Get your key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (default: openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Hugging Face Token (removes rate-limit warnings when downloading embedding models)
# HF_TOKEN=hf_your_token_here
